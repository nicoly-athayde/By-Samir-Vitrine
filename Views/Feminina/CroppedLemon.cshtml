@{
    ViewData["Title"] = "T-shirt Cropped Lemon";
}

<main class="produto-page">

    <div class="produto-container">

        <div class="produto-imagem">
            <img src="~/img/feminina/blusas/cropped_limao.jpeg"
                 asp-append-version="true"
                 alt="T-shirt Cropped Lemon">
        </div>

        <div class="produto-info">

            <h1>T-shirt Cropped Lemon</h1>

            <p>
                Camiseta cropped com estampa inspirada em frutas cítricas,
                trazendo leveza e personalidade ao visual. Tecido confortável
                e modelagem moderna.
            </p>

            <div class="produto-preco">
                R$ 20,00
            </div>

            <button class="btn-carrinho">
                Adicionar ao carrinho
            </button>

        </div>

    </div>

</main>