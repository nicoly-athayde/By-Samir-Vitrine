@{
    ViewData["Title"] = "Bata Assimétrica Branca";
}

<main class="produto-page">

    <div class="produto-container">

        <div class="produto-imagem">
            <img src="~/img/feminina/blusas/bata_branca.jpeg"
                 asp-append-version="true"
                 alt="Bata Assimétrica Branca">
        </div>

        <div class="produto-info">

            <h1>Bata Assimétrica Branca</h1>

            <p>
                Bata branca assimétrica com design moderno e elegante.
                Uma peça leve e sofisticada para compor produções casuais
                ou mais refinadas.
            </p>

            <div class="produto-preco">
                R$ 60,00
            </div>

            <button class="btn-carrinho">
                Adicionar ao carrinho
            </button>

        </div>

    </div>

</main>