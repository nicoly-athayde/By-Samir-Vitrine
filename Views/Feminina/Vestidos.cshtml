@{
    ViewData["Title"] = "Vestidos";
}

<div class="pagina-categoria-feminina">
    <div class="categoria-container">
        <h1 class="visually-hidden">Vestidos</h1>
        <div class="produtos-femininos-grid">
            <article class="produto-feminino-card">
                <a href="#" class="produto-feminino-link" aria-label="Ver Vestido Indiano">
                    <div class="produto-feminino-imagem">
                        <img src="~/img/feminina/vestidos/indiano.jpeg" asp-append-version="true" alt="Vestido Indiano" loading="lazy" />
                    </div>
                    <h2>Vestido Indiano</h2>
                    <p class="produto-preco">R$ 140,00</p>
                </a>
            </article>
            <article class="produto-feminino-card">
                <a href="#" class="produto-feminino-link" aria-label="Ver Vestido Ombro a Ombro">
