@{
    ViewData["Title"] = "Body Rendado";
}

<main class="produto-page">

    <div class="produto-container">

        <div class="produto-imagem">
            <img src="~/img/feminina/blusas/body_rendado.jpeg"
                 asp-append-version="true"
                 alt="Body Rendado">
        </div>

        <div class="produto-info">

            <h1>Body Rendado</h1>

            <p>
                Body rendado sofisticado, perfeito para compor looks elegantes
                e marcantes. Acabamento delicado e modelagem que valoriza o visual.
            </p>

            <div class="produto-preco">
                R$ 50,00
            </div>

            <button class="btn-carrinho">
                Adicionar ao carrinho
            </button>

        </div>

    </div>

</main>