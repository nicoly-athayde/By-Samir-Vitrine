@{
    ViewData["Title"] = "Bata Assimétrica Verde";
}

<main class="produto-page">

    <div class="produto-container">

        <div class="produto-imagem">
            <img src="~/img/feminina/blusas/bata_verde.jpeg"
                 asp-append-version="true"
                 alt="Bata Assimétrica Verde">
        </div>

        <div class="produto-info">

            <h1>Bata Assimétrica Verde</h1>

            <p>
                Bata assimétrica em tom verde suave, com modelagem moderna
                e caimento leve. Ideal para compor produções elegantes e
                confortáveis para diversas ocasiões.
            </p>

            <div class="produto-preco">
                R$ 45,00
            </div>

            <button class="btn-carrinho">
                Adicionar ao carrinho
            </button>

        </div>

    </div>

</main>