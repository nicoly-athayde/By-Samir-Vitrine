@{
    ViewData["Title"] = "T-shirt Cropped Caju";
}

<main class="produto-page">

    <div class="produto-container">

        <div class="produto-imagem">
            <img src="~/img/feminina/blusas/cropped_caju.jpeg"
                 asp-append-version="true"
                 alt="T-shirt Cropped Caju">
        </div>

        <div class="produto-info">

            <h1>T-shirt Cropped Caju</h1>

            <p>
                Camiseta cropped com estampa divertida e colorida,
                ideal para compor looks leves e descontraídos.
                Possui modelagem confortável e tecido macio,
                perfeito para o dia a dia.
            </p>

            <div class="produto-preco">
                R$ 20,00
            </div>

            <button class="btn-carrinho">
                Adicionar ao carrinho
            </button>

        </div>

    </div>

</main>