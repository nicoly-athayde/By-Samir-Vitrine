@{
    ViewData["Title"] = "By Samir - Vitrine Digital";
}

<!-- Hero Section -->
<section class="hero text-center">
    <div class="container hero-content">
        <h1 class="display-1 fw-bold mb-3">By Samir</h1>
        <p class="lead fs-3 mb-4">Estilo único. Presença marcante.</p>
        <p class="mb-5">Barra Bonita • Coleção 2026</p>
        
        <div class="d-flex justify-content-center gap-4">
            <a href="/Produtos" class="btn btn-primary btn-lg px-5 py-3 fs-5">
                Ver Coleção
            </a>
            <a href="https://wa.me/5514999999999" target="_blank" class="btn btn-outline-light btn-lg px-5 py-3 fs-5">
                Falar no WhatsApp
            </a>
        </div>
    </div>
</section>

<!-- Seção de Destaques -->
<div class="container my-5">
    <h2 class="text-center mb-5">Destaques da Coleção</h2>
    
    <div class="row text-center">
        <div class="col-md-4">
            <div class="card product-card h-100">
                <img src="/img/produtos/vestido1.jpg" class="card-img-top" alt="Vestido" style="height: 320px; object-fit: cover;">
                <div class="card-body">
                    <h5>Vestidos</h5>
                    <p class="text-muted">Elegância e conforto</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card product-card h-100">
                <img src="/img/produtos/blazer.jpg" class="card-img-top" alt="Blazer" style="height: 320px; object-fit: cover;">
                <div class="card-body">
                    <h5>Blazers</h5>
                    <p class="text-muted">Estilo sofisticado</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card product-card h-100">
                <img src="/img/produtos/calca.jpg" class="card-img-top" alt="Calça" style="height: 320px; object-fit: cover;">
                <div class="card-body">
                    <h5>Calças</h5>
                    <p class="text-muted">Conforto moderno</p>
                </div>
            </div>
        </div>
    </div>
</div>