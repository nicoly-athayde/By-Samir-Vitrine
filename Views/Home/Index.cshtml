@{
    ViewData["Title"] = "Home";
}

<!-- BANNER -->
<section class="banner-section">
    <div id="bannerPrincipal" class="carousel slide">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="~/img/banners/banner1.png" class="d-block w-100" alt="">
        </div>

        <div class="carousel-item">
            <img src="~/img/banners/banner2.png" class="d-block w-100" alt="">
        </div>

        <div class="carousel-item">
            <img src="~/img/banners/banner3.png" class="d-block w-100" alt="">
        </div>

    </div>

</div>
</section>

<!-- VITRINE -->
<section class="vitrine-section">

    <div class="container">

        <h2 class="titulo-vitrine">
            Vitrine da Semana
        </h2>

        <p class="subtitulo-vitrine">
            Ofertas especiais e novidades que você não pode perder
        </p>

        <div class="row g-4 justify-content-center">

            <!-- PRODUTO 1 -->
            <div class="col-md-4 col-12">
                <div class="produto-card">
                    <img src="~/img/produtos/produto1.png"
                         alt="Produto 1">
                </div>
            </div>

            <!-- PRODUTO 2 -->
            <div class="col-md-4 col-12">
                <div class="produto-card">
                    <img src="~/img/produtos/produto2.png"
                         alt="Produto 2">
                </div>
            </div>

            <!-- PRODUTO 3 -->
            <div class="col-md-4 col-12">
                <div class="produto-card">
                    <img src="~/img/produtos/produto3.png"
                         alt="Produto 3">
                </div>
            </div>

        </div>

    </div>

</section>

<!-- RESERVA -->
<section class="reserva-section">

    <div class="container">

        <h3>Faça sua reserva pelo Whatsapp</h3>

        <p>
            Para mais informações sobre nossos produtos e serviços,
            entre em contato conosco. Estamos aqui para ajudar.
        </p>

        <a href="https://wa.me/5514998991313"
           target="_blank"
           class="btn-whatsapp">

            <i class="fab fa-whatsapp"></i>
            Reservar pelo WhatsApp

        </a>

    </div>

</section>

<!-- LOCALIZAÇÃO -->
<section class="localizacao-section">

    <div class="container">

        <h4>
            Localização: Primeiro de Março, 159 Centro Barra Bonita SP
        </h4>

        <div class="dados-loja">

            <p><strong>Horário:</strong> De segunda a sábado</p>

            <p>(14) 99899-1313</p>

            <p>contato@bysamir.com.br</p>

        </div>

    </div>

</section>

@section Scripts {

<script>
document.addEventListener("DOMContentLoaded", function () {

    const carouselElement =
        document.querySelector('#bannerPrincipal');

    const carousel =
        new bootstrap.Carousel(carouselElement, {

            interval: 6500,
            ride: 'carousel',
            pause: false,
            wrap: true,
            touch: true

        });

});
</script>

}