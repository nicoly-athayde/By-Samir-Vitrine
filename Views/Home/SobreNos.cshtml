@{
    ViewData["Title"] = "Sobre Nós";
}

<section class="sobre-banner">

    <div class="container">

        <img src="~/img/sobre/banner-equipe.jpg"
             alt="Equipe By Samir">

    </div>

</section>

<section class="historia-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-5">

                <h2>Nossa História</h2>

            </div>

            <div class="col-md-7">

                <p>
                    A By Samir nasceu com o propósito de oferecer
                    moda de qualidade, unindo estilo, elegância e
                    atendimento personalizado para cada cliente.
                    Ao longo dos anos, construímos uma relação de
                    confiança com nossa comunidade, tornando-nos
                    referência em moda feminina, masculina e acessórios.
                </p>

            </div>

        </div>

    </div>

</section>

<section class="valores-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-6">

                <img src="~/img/logo/logo.png"
                     class="logo-valores"
                     alt="By Samir">

            </div>

            <div class="col-md-6">

                <h2>Nossos Valores</h2>

                <p>
                    Valorizamos a qualidade, o respeito aos clientes,
                    a transparência e o compromisso com a excelência.
                    Buscamos proporcionar uma experiência única,
                    oferecendo produtos selecionados e um atendimento
                    acolhedor para todos.
                </p>

            </div>

        </div>

    </div>

</section>

<section class="equipe-section">

    <div class="container">

        <h2>Nossa Equipe</h2>

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">
                <div class="membro-card">
                    <img src="~/img/equipe/maria.jpg">
                    <h5>Maria Eduarda</h5>
                    <p>Desenvolvimento Front-End e Design.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="membro-card">
                    <img src="~/img/equipe/leonardo.jpg">
                    <h5>Leonardo</h5>
                    <p>Documentação e desenvolvimento do projeto.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="membro-card">
                    <img src="~/img/equipe/vitor.jpg">
                    <h5>Vitor</h5>
                    <p>Pesquisa, testes e levantamento de requisitos.</p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="localizacao-sobre">

    <div class="container">

        <div class="row">

            <div class="col-md-6">

                <h3>Localização</h3>

                <p>
                    <strong>Visite-nos</strong><br>
                    Barra Bonita - SP
                </p>

                <p>
                    Estamos localizados em Barra Bonita,
                    oferecendo atendimento próximo e
                    personalizado aos nossos clientes.
                </p>

            </div>

            <div class="col-md-6">

                <img src="~/img/sobre/mapa.png"
                     class="img-fluid"
                     alt="Mapa">

            </div>

        </div>

    </div>

</section>