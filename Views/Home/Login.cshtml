@{
    ViewData["Title"] = "Login";
}

<main class="login-page">

    <div class="login-container">

        <!-- CARROSSEL -->
        <div class="login-banner">

            <div id="carouselLogin"
                 class="carousel slide"
                 data-bs-ride="carousel"
                 data-bs-interval="3000">

                <div class="carousel-inner">

                    <div class="carousel-item active">
                        <img src="~/img/banners/foto-login-1.jpeg" alt="Imagem 1">
                    </div>

                    <div class="carousel-item">
                        <img src="~/img/banners/foto-login-2.jpeg" alt="Imagem 2">
                    </div>

                    <div class="carousel-item">
                        <img src="~/img/banners/foto-login-3.jpeg" alt="Imagem 3">
                    </div>

                </div>

            </div>

        </div>

        <!-- FORMULÁRIO -->
        <div class="login-formulario">

            <form>

                <div class="campo-form">
                    <label>Nome completo:</label>
                    <input type="text" />
                </div>

                <div class="campo-form">
                    <label>Data de nascimento:</label>
                    <input type="date" />
                </div>

                <div class="campo-form">
                    <label>CPF:</label>
                    <input type="text" />
                </div>

                <div class="campo-form">
                    <label>E-mail:</label>
                    <input type="email" />
                </div>

                <div class="campo-form">
                    <label>Senha:</label>
                    <input type="password" />
                </div>

                <button type="submit" class="btn-login">
                    Entrar
                </button>

            </form>

        </div>

    </div>

</main>
